@model List<RideBooking.ViewModels.AdminBookingListItemViewModel>
@{
    ViewData["Title"] = "Dispatch Back Office";
    var drivers = ViewBag.ActiveDrivers as List<RideBooking.Models.Driver> ?? new();
    // "Driver_Assigned" is intentionally excluded here — it can only be reached via the
    // "Assign" form/button, which creates the matching DriverAssignment row. Setting it
    // through this free-form dropdown would leave the booking marked as assigned with no
    // driver ever notified (see DriverAssignmentService.UpdateBookingStatusAsync).
    var statuses = new[] { "New", "Confirmed", "Picked_Up", "In_Transit", "Dropped_Off", "Completed", "Cancelled", "No_Show" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="ride-eyebrow mb-1">RideBooking</p>
        <h1 class="fw-bold">Dispatch back office</h1>
    </div>
    <form asp-controller="AdminAuth" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary rounded-pill">Sign out</button>
    </form>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="ride-card mb-4">
    <h2 class="h5 fw-bold mb-3">Add a driver</h2>
    <form asp-controller="Admin" asp-action="CreateDriver" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-2"><input name="Name" class="form-control ride-input" placeholder="Driver name" required /></div>
        <div class="col-md-2"><input name="Phone" class="form-control ride-input" placeholder="Phone" required /></div>
        <div class="col-md-2">
            <select name="VehicleType" class="form-select ride-input" required>
                <option value="Car">Car</option>
                <option value="Van">Van</option>
                <option value="Bus">Bus</option>
            </select>
        </div>
        <div class="col-md-2"><input name="VehicleNumber" class="form-control ride-input" placeholder="Plate no." required /></div>
        <div class="col-md-2"><input name="Pin" class="form-control ride-input" placeholder="4-6 digit PIN" required /></div>
        <div class="col-md-2"><button type="submit" class="btn ride-btn-primary w-100">Add driver</button></div>
    </form>
</div>

@foreach (var booking in Model)
{
    <div class="ride-card mb-3">
        <div class="d-flex justify-content-between flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="h5 fw-bold mb-0">@booking.CustomerName</h2>
                    <span class="ride-pill">@booking.Status</span>
                </div>
                <p class="text-muted small mb-0">@booking.BookingReference &middot; @booking.CustomerPhone</p>
            </div>
            <div class="text-end">
                <p class="fw-bold mb-0">@booking.PickupDate.ToString("yyyy-MM-dd") &middot; @booking.PickupTime.ToString("HH:mm")</p>
                @{
                    // Once a booking has moved past "New" (confirmed, driver assigned, or
                    // further along the trip lifecycle), the fare is locked — editing it
                    // after the customer has been quoted/confirmed would be misleading.
                    var fareIsEditable = booking.Status == "New";
                }
                @if (booking.EstimatedFare is decimal fare && fare > 0)
                {
                    @if (fareIsEditable)
                    {
                        <div class="d-flex align-items-center gap-2 justify-content-end" id="fare-display-@booking.BookingId">
                            <p class="text-muted small mb-0">Est. fare: RM @fare.ToString("0.00")</p>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" onclick="document.getElementById('fare-display-@booking.BookingId').classList.add('d-none'); document.getElementById('fare-form-@booking.BookingId').classList.remove('d-none');">Edit</button>
                        </div>
                        <form id="fare-form-@booking.BookingId" asp-controller="Admin" asp-action="SetFare" method="post" class="d-flex gap-1 justify-content-end d-none">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="BookingId" value="@booking.BookingId" />
                            <input type="number" step="0.01" min="0.01" name="Fare" value="@fare.ToString("0.00")" class="form-control form-control-sm ride-input" placeholder="RM" style="max-width: 100px" required />
                            <button type="submit" class="btn btn-sm ride-btn-primary text-nowrap">Save</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted small mb-1">Est. fare: RM @fare.ToString("0.00")</p>
                    }
                }
                else
                {
                    <p class="text-muted small mb-1">Price not set (automatic estimate unavailable)</p>
                    @if (fareIsEditable)
                    {
                        <form asp-controller="Admin" asp-action="SetFare" method="post" class="d-flex gap-1 justify-content-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="BookingId" value="@booking.BookingId" />
                            <input type="number" step="0.01" min="0.01" name="Fare" class="form-control form-control-sm ride-input" placeholder="RM" style="max-width: 100px" required />
                            <button type="submit" class="btn btn-sm ride-btn-primary text-nowrap">Save price</button>
                        </form>
                    }
                }
            </div>
        </div>

        <div class="ride-section-label">Trip</div>
        <p class="mb-1">@booking.PickupLocation &rarr; @booking.Destination</p>
        <p class="text-muted small">@booking.Passengers pax &middot; @booking.Bags bags &middot; @booking.RequestedVehicleType</p>

        @{
            // Default to only drivers whose registered vehicle type matches the request,
            // so the common case can't be mis-clicked into a mismatch. If none exist, fall
            // back to showing everyone rather than leaving the admin unable to assign anyone.
            var matchingDrivers = drivers.Where(d => d.VehicleType == booking.RequestedVehicleType).ToList();
            var dropdownDrivers = matchingDrivers.Any() ? matchingDrivers : drivers;
        }
        <div class="row g-2 mt-2">
            <div class="col-md-6">
                <form asp-controller="Admin" asp-action="AssignDriver" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BookingId" value="@booking.BookingId" />
                    <select name="DriverId" class="form-select ride-input">
                        @foreach (var driver in dropdownDrivers)
                        {
                            @if (driver.Id == booking.AssignedDriverId)
                            {
                                <option value="@driver.Id" selected>@driver.Name (@driver.VehicleType)</option>
                            }
                            else
                            {
                                <option value="@driver.Id">@driver.Name (@driver.VehicleType)</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn ride-btn-primary text-nowrap">Assign</button>
                </form>
                @if (!matchingDrivers.Any())
                {
                    <p class="text-warning small mt-1 mb-0">No @booking.RequestedVehicleType drivers available — showing all drivers</p>
                }
            </div>
            <div class="col-md-6">
                <form asp-controller="Admin" asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BookingId" value="@booking.BookingId" />
                    <select name="NewStatus" class="form-select ride-input">
                        @foreach (var status in statuses)
                        {
                            @if (status == booking.Status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-secondary text-nowrap">Update status</button>
                </form>
            </div>
        </div>

        @if (booking.AssignedDriverName != null)
        {
            <p class="text-muted small mt-2 mb-0">Assigned: @booking.AssignedDriverName (@booking.AssignedDriverPhone) &middot; @booking.AssignmentStatus</p>
        }
    </div>
}
