@model List<RideReady.ViewModels.AdminBookingListItemViewModel>
@{
    ViewData["Title"] = "Dispatch Back Office";
    ViewData["PageHeading"] = "Dispatch back office";
    ViewData["Bare"] = true;
    ViewData["HidePublicHeader"] = true;
    var drivers = ViewBag.ActiveDrivers as List<RideReady.Models.Driver> ?? new();
    // "Driver_Assigned" is intentionally excluded here — it can only be reached via the
    // "Assign" form/button, which creates the matching DriverAssignment row. Setting it
    // through this free-form dropdown would leave the booking marked as assigned with no
    // driver ever notified (see DriverAssignmentService.UpdateBookingStatusAsync).
    var statuses = new[] { "New", "Confirmed", "Picked_Up", "In_Transit", "Dropped_Off", "Completed", "Cancelled", "No_Show" };
    var currentSort = ViewBag.Sort as string ?? "booked";
    // How many bookings carry each attention flag (for the summary chips) and sit in each status chip.
    var flagCounts = RideReady.ViewModels.DashboardAttention.AllFlags
        .Select(f => (Flag: f, Count: Model.Count(b => b.AttentionFlags.Any(x => x.Key == f.Key))))
        .Where(x => x.Count > 0)
        .ToList();
    Func<string, int> statusCount = key => Model.Count(b => RideReady.ViewModels.DashboardFilter.StatusGroup(b.Status) == key);
}

@await Html.PartialAsync("_AdminHeader")

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="rr-ok rr-msg" role="status"><div><b>Done.</b><span>@successMessage</span></div></div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="rr-err rr-msg" role="alert"><div><b>Could not do that.</b><span>@errorMessage</span></div></div>
}

@if (flagCounts.Count > 0)
{
    <div class="rr-flag-bar" role="group" aria-label="Needs attention">
        <span class="rr-flag">Needs attention</span>
        @foreach (var item in flagCounts)
        {
            <button type="button" class="rr-chip rr-chip-flag" data-flag="@item.Flag.Key" aria-pressed="false">@item.Flag.Label <span class="rr-chip-n">@item.Count</span></button>
        }
    </div>
}

<div class="rr-tools">
    <input type="search" id="rr-search" class="rr-input" placeholder="Search name, phone, reference or route" aria-label="Search bookings" autocomplete="off" />
    <div class="rr-chips" role="group" aria-label="Filter by status">
        <button type="button" class="rr-chip on" data-status="all" aria-pressed="true">All <span class="rr-chip-n">@Model.Count</span></button>
        @foreach (var chip in RideReady.ViewModels.DashboardFilter.StatusChips)
        {
            <button type="button" class="rr-chip" data-status="@chip.Key" aria-pressed="false">@chip.Label <span class="rr-chip-n">@statusCount(chip.Key)</span></button>
        }
    </div>
    <form method="get" class="rr-sort">
        <label for="sort">Sort by</label>
        <select id="sort" name="sort" class="rr-input" onchange="this.form.submit()">
            <option value="booked" selected="@(currentSort == "booked")">Date booked (newest first)</option>
            <option value="pickup" selected="@(currentSort == "pickup")">Scheduled date (earliest first)</option>
        </select>
        <noscript><button type="submit" class="rr-btn rr-btn-sec rr-btn-sm">Apply</button></noscript>
    </form>
</div>
<p class="rr-count-line" id="rr-count-line" role="status" aria-live="polite" hidden></p>

@if (!Model.Any())
{
    <div class="rr-acard"><p class="rr-note rr-flush">No active bookings right now. New bookings appear here as soon as customers submit them.</p></div>
}

@foreach (var booking in Model)
{
    var vehicleImage = booking.RequestedVehicleType switch
    {
        "Van" => "vehicle-van.svg",
        "Bus" => "vehicle-bus.svg",
        _ => "vehicle-sedan.svg"
    };

    <article class="rr-acard"
             data-booking
             data-status="@RideReady.ViewModels.DashboardFilter.StatusGroup(booking.Status)"
             data-flags="@string.Join(' ', booking.AttentionFlags.Select(f => f.Key))"
             data-search="@RideReady.ViewModels.DashboardFilter.SearchText(booking)">
        @await Html.PartialAsync("_StatusStepper", booking.Status)

        <div class="rr-head">
            <div class="rr-who">
                <img src="~/images/@vehicleImage" alt="@booking.RequestedVehicleType" />
                <div>
                    <h2>@booking.CustomerName</h2>
                    <div class="rr-tags">
                        <span class="rr-badge">@booking.Status</span>
                        @foreach (var flag in booking.AttentionFlags)
                        {
                            <span class="rr-flag rr-flag-inline">@flag.Label</span>
                        }
                    </div>
                    <p class="rr-ref">
                        @booking.BookingReference &middot;
                        <a href="@RideReady.ViewModels.PhoneLinks.Tel(booking.CustomerPhone)" aria-label="Call @booking.CustomerName">@booking.CustomerPhone</a>
                        &middot;
                        <a href="@RideReady.ViewModels.PhoneLinks.WhatsApp(booking.CustomerPhone)" target="_blank" rel="noopener" aria-label="WhatsApp @booking.CustomerName">WhatsApp</a>
                    </p>
                </div>
            </div>
            <div class="rr-when">
                <strong>@booking.PickupDate.ToString("yyyy-MM-dd") &middot; @booking.PickupTime.ToString("HH:mm")</strong>
                <span>Booked @booking.BookedAt.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                @{
                    // The fare can be set or changed until the trip starts (New, Driver_Assigned,
                    // Confirmed). From Picked_Up onward it is locked — changing it mid/after the trip
                    // would be misleading.
                    var fareIsEditable = RideReady.Services.BookingService.FareEditableStatuses.Contains(booking.Status);
                }
                @if (booking.EstimatedFare is decimal fare && fare > 0)
                {
                    @if (fareIsEditable)
                    {
                        <div class="rr-price" id="fare-display-@booking.BookingId">
                            <span>Est. fare: RM @fare.ToString("0.00")</span>
                            <button type="button" class="rr-btn rr-btn-sec rr-btn-sm" onclick="document.getElementById('fare-display-@booking.BookingId').hidden = true; document.getElementById('fare-form-@booking.BookingId').hidden = false;">Edit</button>
                        </div>
                        <form id="fare-form-@booking.BookingId" asp-controller="Admin" asp-action="SetFare" method="post" class="rr-price" hidden>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="BookingId" value="@booking.BookingId" />
                            <input type="number" step="0.01" min="0.01" name="Fare" value="@fare.ToString("0.00")" class="rr-input" placeholder="RM" aria-label="Price in RM" required />
                            <button type="submit" class="rr-btn">Save</button>
                        </form>
                    }
                    else
                    {
                        <span>Est. fare: RM @fare.ToString("0.00")</span>
                    }
                }
                else
                {
                    <span>Price not set (automatic estimate unavailable)</span>
                    @if (fareIsEditable)
                    {
                        <form asp-controller="Admin" asp-action="SetFare" method="post" class="rr-price">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="BookingId" value="@booking.BookingId" />
                            <input type="number" step="0.01" min="0.01" name="Fare" class="rr-input" placeholder="RM" aria-label="Price in RM" required />
                            <button type="submit" class="rr-btn">Save price</button>
                        </form>
                    }
                }
            </div>
        </div>

        <div class="rr-sec-label">Trip</div>
        @await Html.PartialAsync("_TripDetails", RideReady.ViewModels.TripDetailsViewModel.ForAdmin(booking))

        @{
            // Default to only drivers whose registered vehicle type matches the request,
            // so the common case can't be mis-clicked into a mismatch. If none exist, fall
            // back to showing everyone rather than leaving the admin unable to assign anyone.
            var matchingDrivers = drivers.Where(d => d.VehicleType == booking.RequestedVehicleType).ToList();
            var dropdownDrivers = matchingDrivers.Any() ? matchingDrivers : drivers;
        }
        <div class="rr-actions">
            <div>
                <form asp-controller="Admin" asp-action="AssignDriver" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BookingId" value="@booking.BookingId" />
                    <select name="DriverId" class="rr-input" aria-label="Driver">
                        @foreach (var driver in dropdownDrivers)
                        {
                            var label = $"{driver.Name} ({driver.VehicleType})";
                            var hasConflict = booking.DriverConflicts.TryGetValue(driver.Id, out var conflictReason);
                            if (hasConflict)
                            {
                                label += $" - {conflictReason}";
                            }
                            var optionClass = hasConflict ? "rr-muted" : "";
                            @if (driver.Id == booking.AssignedDriverId)
                            {
                                <option value="@driver.Id" selected class="@optionClass">@label</option>
                            }
                            else
                            {
                                <option value="@driver.Id" class="@optionClass">@label</option>
                            }
                        }
                    </select>
                    <button type="submit" class="rr-btn">Assign</button>
                </form>
                @if (!matchingDrivers.Any())
                {
                    <p class="rr-warn">No @booking.RequestedVehicleType drivers available — showing all drivers</p>
                }
            </div>
            <div>
                <form asp-controller="Admin" asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BookingId" value="@booking.BookingId" />
                    <select name="NewStatus" class="rr-input" aria-label="Status">
                        @foreach (var status in statuses)
                        {
                            @if (status == booking.Status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                    <button type="submit" class="rr-btn rr-btn-sec">Update status</button>
                </form>
            </div>
        </div>

        @if (booking.AssignedDriverName != null)
        {
            <p class="rr-note">
                Assigned: @booking.AssignedDriverName
                (<a href="@RideReady.ViewModels.PhoneLinks.Tel(booking.AssignedDriverPhone)" aria-label="Call @booking.AssignedDriverName">@booking.AssignedDriverPhone</a>,
                <a href="@RideReady.ViewModels.PhoneLinks.WhatsApp(booking.AssignedDriverPhone)" target="_blank" rel="noopener" aria-label="WhatsApp @booking.AssignedDriverName">WhatsApp</a>)
                &middot; @booking.AssignmentStatus
            </p>
        }

        @if (booking.AssignmentStatus == "Accepted")
        {
            <div class="rr-ok">
                <div>
                    <b>Driver accepted</b>
                    <span>
                        @if (booking.DriverDetailsSentAt is DateTime detailsSentAt)
                        {
                            <text>Sent to customer @detailsSentAt.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</text>
                        }
                        else
                        {
                            <text>Not sent to the customer yet</text>
                        }
                    </span>
                </div>
                <form asp-controller="Admin" asp-action="SendDriverDetails" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                    <button type="submit" class="rr-btn rr-btn-sm">@(booking.DriverDetailsSentAt == null ? "Send driver details to customer" : "Resend to customer")</button>
                </form>
            </div>
        }
    </article>
}

@if (Model.Any())
{
    <div class="rr-acard" id="rr-no-match" hidden>
        <p class="rr-note rr-flush">No bookings match your search or filter. Clear the search box or choose "All".</p>
    </div>
}

@section Scripts {
    <script>
        // On a phone the seven steps scroll sideways; bring each booking's current step into view.
        document.querySelectorAll(".rr-trip-steps").forEach(function (steps) {
            var now = steps.querySelector(".rr-ts-now");
            if (now) {
                steps.scrollLeft = now.offsetLeft - (steps.clientWidth - now.clientWidth) / 2;
            }
        });
    </script>
    <script>
        // Search and filter the booking cards on this page (instant, nothing is sent to the server).
        (function () {
            var cards = Array.prototype.slice.call(document.querySelectorAll("[data-booking]"));
            var search = document.getElementById("rr-search");
            if (!search || cards.length === 0) { return; }

            var statusChips = Array.prototype.slice.call(document.querySelectorAll(".rr-chip[data-status]"));
            var flagChips = Array.prototype.slice.call(document.querySelectorAll(".rr-chip[data-flag]"));
            var noMatch = document.getElementById("rr-no-match");
            var countLine = document.getElementById("rr-count-line");
            var state = { text: "", status: "all", flag: "" };

            function digits(text) { return text.replace(/\D/g, ""); }

            function matches(card) {
                if (state.status !== "all" && card.getAttribute("data-status") !== state.status) { return false; }
                if (state.flag && (" " + card.getAttribute("data-flags") + " ").indexOf(" " + state.flag + " ") === -1) { return false; }
                if (state.text) {
                    var haystack = card.getAttribute("data-search");
                    var words = state.text.split(/\s+/).filter(Boolean);
                    return words.every(function (word) {
                        return haystack.indexOf(word) !== -1 || (digits(word).length >= 3 && haystack.indexOf(digits(word)) !== -1);
                    });
                }
                return true;
            }

            function apply() {
                var shown = 0;
                cards.forEach(function (card) {
                    var show = matches(card);
                    card.hidden = !show;
                    if (show) { shown++; }
                });
                if (noMatch) { noMatch.hidden = shown !== 0; }
                var filtering = state.text || state.status !== "all" || state.flag;
                countLine.hidden = !filtering;
                countLine.textContent = filtering ? "Showing " + shown + " of " + cards.length + " bookings" : "";
            }

            search.addEventListener("input", function () {
                state.text = search.value.trim().toLowerCase();
                apply();
            });

            statusChips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    state.status = chip.getAttribute("data-status");
                    statusChips.forEach(function (c) {
                        var on = c === chip;
                        c.classList.toggle("on", on);
                        c.setAttribute("aria-pressed", on ? "true" : "false");
                    });
                    apply();
                });
            });

            // The "Needs attention" chips filter to the bookings that carry that flag; click again to clear.
            flagChips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    var flag = chip.getAttribute("data-flag");
                    state.flag = state.flag === flag ? "" : flag;
                    flagChips.forEach(function (c) {
                        var on = c.getAttribute("data-flag") === state.flag;
                        c.classList.toggle("on", on);
                        c.setAttribute("aria-pressed", on ? "true" : "false");
                    });
                    apply();
                });
            });
        })();
    </script>
}
