@{
    var heading = ViewData["PageHeading"] as string ?? ViewData["Title"] as string ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"] as string ?? string.Empty;

    // Which navigation button is the current page.
    bool Current(params string[] actions) => actions.Contains(action, StringComparer.OrdinalIgnoreCase);
}
<header class="rr-banner">
    <div class="rr-brandrow">
        <span class="rr-plate"><img src="~/images/h4t-travel-services-logo.jpg" alt="h4t Travel Services Sdn Bhd" /></span>
        <span class="rr-pill rr-pill-sun">RideReady</span>
    </div>
    <h1>@heading</h1>
    <nav class="rr-nav" aria-label="Back office">
        <a asp-controller="Admin" asp-action="Index" class="@(Current("Index") ? "on" : null)" aria-current="@(Current("Index") ? "page" : null)">Dashboard</a>
        <a asp-controller="Admin" asp-action="Drivers" class="@(Current("Drivers", "EditDriver") ? "on" : null)" aria-current="@(Current("Drivers", "EditDriver") ? "page" : null)">Drivers</a>
        <a asp-controller="Admin" asp-action="Calendar" class="@(Current("Calendar") ? "on" : null)" aria-current="@(Current("Calendar") ? "page" : null)">Calendar</a>
        <form asp-controller="AdminAuth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="rr-out">Sign out</button>
        </form>
    </nav>
</header>
