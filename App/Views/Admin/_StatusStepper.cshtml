@model string
@using RideReady.ViewModels
@{
    var offTrackLabel = BookingProgress.OffTrackLabel(Model);
    var steps = BookingProgress.GetSteps(Model);
    var current = steps.FirstOrDefault(s => s.State == StepState.Current);
}
@if (offTrackLabel != null)
{
    <div class="rr-ts-off" role="status">
        <span class="rr-flag rr-flag-danger">@offTrackLabel</span>
    </div>
}
else
{
    <ol class="rr-trip-steps" aria-label="@(current != null ? $"Trip progress: {current.Label}, step {current.Number} of {BookingProgress.TotalSteps}" : "Trip progress")">
        @foreach (var step in steps)
        {
            var css = step.State switch
            {
                StepState.Done => "rr-ts rr-ts-done",
                StepState.Current => "rr-ts rr-ts-now",
                _ => "rr-ts"
            };
            <li class="@css" aria-current="@(step.State == StepState.Current ? "step" : null)">
                <span class="rr-ts-c">@step.Number</span>
                @step.Label
            </li>
        }
    </ol>
}
