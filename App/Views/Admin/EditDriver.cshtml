@model RideReady.ViewModels.EditDriverViewModel
@{
    ViewData["Title"] = "Edit driver";
    ViewData["PageHeading"] = "Edit driver";
    ViewData["Bare"] = true;
    ViewData["HidePublicHeader"] = true;
}

@await Html.PartialAsync("_AdminHeader")

<section class="rr-acard rr-panel rr-panel-narrow">
    <form asp-controller="Admin" asp-action="EditDriver" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="rr-summary"></div>

        <div class="rr-row">
            <div class="rr-field">
                <label asp-for="Name" class="rr-label"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="rr-error"></span>
            </div>
        </div>
        <div class="rr-row">
            <div class="rr-field">
                <label asp-for="Phone" class="rr-label"></label>
                <input asp-for="Phone" type="tel" />
                <span asp-validation-for="Phone" class="rr-error"></span>
            </div>
        </div>
        <div class="rr-row rr-r3">
            <div class="rr-field">
                <label asp-for="VehicleType" class="rr-label"></label>
                <select asp-for="VehicleType">
                    <option value="Car">Car</option>
                    <option value="Van">Van</option>
                    <option value="Bus">Bus</option>
                </select>
                <span asp-validation-for="VehicleType" class="rr-error"></span>
            </div>
            <div class="rr-field">
                <label asp-for="VehicleNumber" class="rr-label"></label>
                <input asp-for="VehicleNumber" />
                <span asp-validation-for="VehicleNumber" class="rr-error"></span>
            </div>
            <div class="rr-field">
                <label asp-for="PassengerCapacity" class="rr-label"></label>
                <input asp-for="PassengerCapacity" type="number" min="1" max="100" />
                <span asp-validation-for="PassengerCapacity" class="rr-error"></span>
            </div>
        </div>
        <div class="rr-check rr-check-block">
            <input asp-for="IsActive" />
            <label asp-for="IsActive">Active (can be assigned and counts towards booking capacity)</label>
        </div>

        <div class="rr-btn-row">
            <button type="submit" class="rr-btn">Save changes</button>
            <a asp-controller="Admin" asp-action="Drivers" class="rr-btn rr-btn-sec">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
