@model List<RideReady.ViewModels.DriverAssignmentListItemViewModel>
@{
    ViewData["Title"] = "My Assigned Trips";
    ViewData["Bare"] = true;
    ViewData["HidePublicHeader"] = true;
    var activeBooking = Model.FirstOrDefault(a => a.AssignmentStatus == "Accepted" && a.BookingStatus != "Completed");
}

<div class="rr-driver">
    <header class="rr-banner">
        <div class="rr-brandrow">
            <span class="rr-plate"><img src="~/images/h4t-travel-services-logo.jpg" alt="h4t Travel Services Sdn Bhd" /></span>
            <span class="rr-pill rr-pill-sun">RideReady driver</span>
            <form asp-controller="DriverAuth" asp-action="Logout" method="post" class="rr-signout">
                @Html.AntiForgeryToken()
                <button type="submit" class="rr-out">Sign out</button>
            </form>
        </div>
        <h1>My assigned trips</h1>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="rr-ok rr-msg" role="status"><div><b>Done.</b><span>@successMessage</span></div></div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="rr-err rr-msg" role="alert"><div><b>Something went wrong.</b><span>@errorMessage</span></div></div>
    }

    <section class="rr-acard rr-loc">
        <span class="rr-loc-icon" aria-hidden="true"><i></i></span>
        <div class="rr-loc-text">
            <strong>Location sharing</strong>
            <span>Share your live location with dispatch while this page stays open.</span>
        </div>
        <button id="locationToggle" type="button" class="rr-btn" data-booking-id="@activeBooking?.BookingId">Share my location</button>
    </section>

    @if (!Model.Any())
    {
        <section class="rr-acard rr-empty">
            <h2>No trips assigned</h2>
            <p>Your dispatcher will assign a trip to your phone number.</p>
        </section>
    }

    @foreach (var trip in Model)
    {
        <article class="rr-acard">
            <div class="rr-trip-head">
                <div>
                    <h2>@trip.CustomerName</h2>
                    <p class="rr-ref">@trip.BookingReference &middot; @trip.CustomerPhone</p>
                </div>
                <div class="rr-when">
                    <strong>@trip.PickupDate.ToString("yyyy-MM-dd") &middot; @trip.PickupTime.ToString("HH:mm")</strong>
                    <span class="rr-badge">@trip.AssignmentStatus / @trip.BookingStatus</span>
                </div>
            </div>
            @await Html.PartialAsync("_TripDetails", RideReady.ViewModels.TripDetailsViewModel.ForDriver(trip))

            @if (trip.AssignmentStatus == "Pending")
            {
                <div class="rr-actions rr-actions-pair">
                    <form asp-controller="Driver" asp-action="Accept" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="assignmentId" value="@trip.AssignmentId" />
                        <button type="submit" class="rr-btn">Accept</button>
                    </form>
                    <form asp-controller="Driver" asp-action="Reject" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="assignmentId" value="@trip.AssignmentId" />
                        <button type="submit" class="rr-btn rr-btn-sec">Reject</button>
                    </form>
                </div>
            }
            else if (trip.AssignmentStatus == "Accepted" && trip.BookingStatus != "Completed")
            {
                <form asp-controller="Driver" asp-action="UpdateStatus" method="post" class="rr-actions">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@trip.BookingId" />
                    <select name="newStatus" aria-label="New status">
                        <option value="Picked_Up">Picked Up</option>
                        <option value="In_Transit">In Transit</option>
                        <option value="Dropped_Off">Dropped Off</option>
                        <option value="Completed">Completed</option>
                    </select>
                    <button type="submit" class="rr-btn">Update status</button>
                </form>
            }
        </article>
    }
</div>

@section Scripts {
    <script src="~/js/driver-location.js" asp-append-version="true"></script>
}
