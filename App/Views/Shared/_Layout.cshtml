<!DOCTYPE html>
<html lang="en">
@{
    // Back-office pages (ViewData["HidePublicHeader"]) draw their own banner (logo, title, navigation) and sit inside a
    // wide wrapper; every other page gets the public RideReady header.
    var backOffice = ViewData["HidePublicHeader"] as bool? ?? false;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - RideReady</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/rideready-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rideready.css" asp-append-version="true" />
</head>
<body class="rr-body">
    @if (!backOffice)
    {
        <partial name="_PublicHeader" />
    }
    <main role="main">
        @if (backOffice)
        {
            <div class="rr-wrap">@RenderBody()</div>
        }
        else
        {
            @RenderBody()
        }
    </main>
    <footer class="rr-foot">
        Powered by LitXus
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
