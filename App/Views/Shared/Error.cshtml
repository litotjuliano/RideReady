@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["Bare"] = true;
}

<div class="rr-narrow">
    <div class="rr-card">
        <span class="rr-pill rr-pill-sun">Sorry</span>
        <h1>Something went wrong.</h1>
        <p>We could not finish that request. Please go back and try again. If it keeps happening, contact our dispatch team.</p>

        @if (Model.ShowRequestId)
        {
            <p class="rr-muted">Request ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Booking" asp-action="Create" class="rr-go">Back to booking <i aria-hidden="true"></i></a>
    </div>
</div>
