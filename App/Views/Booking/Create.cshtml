@model RideReady.ViewModels.BookingRequestViewModel
@{
    ViewData["Title"] = "Book a Ride";
    ViewData["Bare"] = true;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = DateTime.Today.AddDays(30).ToString("yyyy-MM-dd");
    var maxDropOffDate = DateTime.Today.AddDays(31).ToString("yyyy-MM-dd");
    // Passenger limits per vehicle come from one place (VehicleCapacity), shared with the server-side checks.
    var carMax = RideReady.ViewModels.VehicleCapacity.MaxFor("Car");
    var vanMax = RideReady.ViewModels.VehicleCapacity.MaxFor("Van");
    var busMax = RideReady.ViewModels.VehicleCapacity.MaxFor("Bus");
}

<div class="rr-hero">
    <div class="rr-hero-in">
        <section class="rr-copy">
            <span class="rr-pill rr-pill-sun">Easy local transport</span>
            <h1>Your next ride, arranged in minutes.</h1>
            <p>Complete one simple form. Our dispatch team will assign your vehicle and driver, then coordinate the trip schedule.</p>
            <ol class="rr-steps">
                <li><div class="rr-n">1</div><div><strong>Enter trip details</strong><span>Tell us where, when and how many.</span></div></li>
                <li><div class="rr-n">2</div><div><strong>Dispatch assigns driver</strong><span>We match your vehicle and driver.</span></div></li>
                <li><div class="rr-n">3</div><div><strong>Trip is scheduled</strong><span>We contact you to confirm.</span></div></li>
            </ol>
            <img class="rr-letsgo" src="~/images/lets-go-badge.png" alt="Let's go" />
        </section>

        <div class="rr-card">
            <div class="rr-card-head">
                <span class="rr-pill">Book a ride</span>
                <span class="rr-pill rr-pill-quiet">Available daily</span>
            </div>
            <h2>Trip details</h2>

            <form asp-controller="Booking" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="rr-summary"></div>

                <div class="rr-sec">Your details</div>
                <div class="rr-row">
                    <div class="rr-field">
                        <label asp-for="CustomerName" class="rr-label"></label>
                        <input asp-for="CustomerName" placeholder="Full name" />
                        <span asp-validation-for="CustomerName" class="rr-error"></span>
                    </div>
                </div>
                <div class="rr-row rr-r2">
                    <div class="rr-field">
                        <label asp-for="CustomerPhone" class="rr-label"></label>
                        <input asp-for="CustomerPhone" placeholder="e.g. 0123456789" />
                        <span asp-validation-for="CustomerPhone" class="rr-error"></span>
                    </div>
                    <div class="rr-field">
                        <label asp-for="CustomerEmail" class="rr-label"></label>
                        <input asp-for="CustomerEmail" placeholder="you@example.com" />
                        <span asp-validation-for="CustomerEmail" class="rr-error"></span>
                    </div>
                </div>

                <div class="rr-sec">Trip</div>
                <div class="rr-row rr-r2">
                    <div class="rr-field">
                        <label asp-for="FromName" class="rr-label"></label>
                        <input asp-for="FromName" maxlength="255" placeholder="e.g. KLIA Terminal 1" />
                        <span asp-validation-for="FromName" class="rr-error"></span>
                    </div>
                    <div class="rr-field">
                        <label asp-for="ToName" class="rr-label"></label>
                        <input asp-for="ToName" maxlength="255" placeholder="e.g. Mid Valley" />
                        <span asp-validation-for="ToName" class="rr-error"></span>
                    </div>
                </div>
                <div class="rr-row rr-r2">
                    <div class="rr-field">
                        <label asp-for="PickupLocation" class="rr-label"></label>
                        <textarea asp-for="PickupLocation" rows="2" maxlength="255" data-count="PickupLocation" placeholder="Full pick up address"></textarea>
                        <span class="rr-hint rr-count"><span data-count-for="PickupLocation">0</span>/255</span>
                        <span asp-validation-for="PickupLocation" class="rr-error"></span>
                    </div>
                    <div class="rr-field">
                        <label asp-for="Destination" class="rr-label"></label>
                        <textarea asp-for="Destination" rows="2" maxlength="255" data-count="Destination" placeholder="Full drop-off address"></textarea>
                        <span class="rr-hint rr-count"><span data-count-for="Destination">0</span>/255</span>
                        <span asp-validation-for="Destination" class="rr-error"></span>
                    </div>
                </div>
                <div class="rr-row rr-r2">
                    <div class="rr-field">
                        <label asp-for="PickupDate" class="rr-label"></label>
                        <input asp-for="PickupDate" type="date" min="@today" max="@maxDate" />
                        <span asp-validation-for="PickupDate" class="rr-error"></span>
                    </div>
                    <div class="rr-field">
                        <label asp-for="PickupTime" class="rr-label"></label>
                        <input asp-for="PickupTime" type="time" min="06:00" max="23:45" step="900" />
                        <span asp-validation-for="PickupTime" class="rr-error"></span>
                        <span class="rr-hint">Bookings available 6:00 AM - midnight, 15-minute slots.</span>
                    </div>
                </div>
                <div class="rr-row rr-r2">
                    <div class="rr-field">
                        <label asp-for="DropOffDate" class="rr-label"></label>
                        <input asp-for="DropOffDate" type="date" min="@today" max="@maxDropOffDate" />
                        <span asp-validation-for="DropOffDate" class="rr-error"></span>
                    </div>
                    <div class="rr-field">
                        <label asp-for="DropOffTime" class="rr-label"></label>
                        <input asp-for="DropOffTime" type="time" step="900" />
                        <span asp-validation-for="DropOffTime" class="rr-error"></span>
                        <span class="rr-hint">Approximate arrival time, e.g. should be there by 3pm.</span>
                    </div>
                </div>

                <div class="rr-sec">Passengers &amp; vehicle</div>
                <div class="rr-row rr-r2">
                    <div class="rr-field">
                        <label asp-for="Passengers" class="rr-label"></label>
                        <input asp-for="Passengers" type="number" min="1" max="8" />
                        <span class="rr-hint" id="PassengersHint">Up to 8 passengers.</span>
                        <span class="rr-error" id="PassengersCapacity" role="alert" hidden></span>
                        <span asp-validation-for="Passengers" class="rr-error"></span>
                    </div>
                    <div class="rr-field">
                        <label asp-for="Bags" class="rr-label"></label>
                        <input asp-for="Bags" type="number" min="0" max="10" />
                        <span asp-validation-for="Bags" class="rr-error"></span>
                    </div>
                </div>
                <div class="rr-row">
                    <div class="rr-field">
                        <span class="rr-label" id="VehicleTypeLabel">@Html.DisplayNameFor(m => m.VehicleType)</span>
                        <div class="rr-veh-wrap" role="radiogroup" aria-labelledby="VehicleTypeLabel">
                            <label class="rr-veh" for="VehicleType">
                                <input asp-for="VehicleType" type="radio" value="Car" id="VehicleType" data-capacity="@carMax" />
                                <span><img src="~/images/vehicle-sedan.svg" alt="" />Car<small>Up to @carMax passengers</small></span>
                            </label>
                            <label class="rr-veh" for="VehicleType_Van">
                                <input asp-for="VehicleType" type="radio" value="Van" id="VehicleType_Van" data-capacity="@vanMax" />
                                <span><img src="~/images/vehicle-van.svg" alt="" />Van<small>Up to @vanMax passengers</small></span>
                            </label>
                            <label class="rr-veh" for="VehicleType_Bus">
                                <input asp-for="VehicleType" type="radio" value="Bus" id="VehicleType_Bus" data-capacity="@busMax" />
                                <span><img src="~/images/vehicle-bus.svg" alt="" />Bus<small>Up to @busMax passengers</small></span>
                            </label>
                        </div>
                        <span asp-validation-for="VehicleType" class="rr-error"></span>
                    </div>
                </div>
                <div class="rr-row">
                    <div class="rr-field">
                        <div class="rr-label-row"><label asp-for="Notes" class="rr-label"></label><small>(optional)</small></div>
                        <textarea asp-for="Notes" rows="3" placeholder="Flight number, luggage, child seat, or any other requests"></textarea>
                        <span asp-validation-for="Notes" class="rr-error"></span>
                    </div>
                </div>

                <div class="rr-sec">Payment &amp; confirmation</div>
                <div class="rr-row">
                    <div class="rr-field">
                        <label asp-for="PaymentMethod" class="rr-label"></label>
                        <select asp-for="PaymentMethod">
                            <option value="Pay_at_Pickup">Pay at Pickup</option>
                            <option value="Bank_Transfer">Bank Transfer</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="rr-error"></span>
                    </div>
                </div>

                <div class="rr-check">
                    <input asp-for="AcceptedTerms" />
                    <label asp-for="AcceptedTerms">I accept the terms and conditions</label>
                </div>
                <span asp-validation-for="AcceptedTerms" class="rr-error rr-check-error"></span>

                <button type="submit" class="rr-go">Submit booking <i aria-hidden="true"></i></button>
                <p class="rr-fine">No online payment required. Our team will contact you to confirm.</p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Client rule for [MustBeTrue]: the checkbox must be ticked.
        if (window.jQuery && jQuery.validator && jQuery.validator.unobtrusive) {
            jQuery.validator.addMethod("mustbetrue", function (value, element) { return element.checked; });
            jQuery.validator.unobtrusive.adapters.addBool("mustbetrue");
        }

        // jquery-validate's "step" rule throws on <input type="time"> (step is in seconds there,
        // and the browser's own picker already enforces it). Skip the rule for time inputs.
        if (window.jQuery && jQuery.validator) {
            var originalStep = jQuery.validator.methods.step;
            jQuery.validator.methods.step = function (value, element, param) {
                if (element.type === "time") { return true; }
                return originalStep.call(this, value, element, param);
            };
        }
    </script>

    <script>
        // Live character counters for the address boxes (limit 255).
        document.querySelectorAll("textarea[data-count]").forEach(function (box) {
            var counter = document.querySelector('[data-count-for="' + box.getAttribute("data-count") + '"]');
            var update = function () { if (counter) { counter.textContent = box.value.length; } };
            box.addEventListener("input", update);
            update();
        });

        // The drop-off can't be before the pickup date: use it as the minimum and as the default.
        (function () {
            var pickupDate = document.getElementById("PickupDate");
            var dropOffDate = document.getElementById("DropOffDate");
            if (!pickupDate || !dropOffDate) { return; }
            var sync = function () {
                if (!pickupDate.value) { return; }
                dropOffDate.min = pickupDate.value;
                if (!dropOffDate.value || dropOffDate.value < pickupDate.value) {
                    dropOffDate.value = pickupDate.value;
                }
            };
            pickupDate.addEventListener("change", sync);
            sync();
        })();
    </script>

    <script>
        // Passenger limit per vehicle. The numbers come from the server (data-capacity on each vehicle card), which
        // reads them from VehicleCapacity, and the server checks the same rule again on submit.
        (function () {
            var passengers = document.getElementById("Passengers");
            var hint = document.getElementById("PassengersHint");
            var message = document.getElementById("PassengersCapacity");
            var radios = Array.prototype.slice.call(document.querySelectorAll('input[name="VehicleType"]'));
            if (!passengers || !hint || !message || radios.length === 0) { return; }

            var largest = Number(passengers.getAttribute("max")) || 8;

            function selected() {
                return radios.filter(function (r) { return r.checked; })[0] || null;
            }

            function capacityOf(radio) {
                return Number(radio.getAttribute("data-capacity")) || largest;
            }

            // Vehicle types big enough for the number of passengers.
            function biggerThan(count) {
                return radios.filter(function (r) { return capacityOf(r) >= count; }).map(function (r) { return r.value; });
            }

            function check() {
                var radio = selected();
                var count = Number(passengers.value);
                var tooMany = !!radio && count > capacityOf(radio);

                hint.hidden = tooMany;
                hint.textContent = radio
                    ? "A " + radio.value + " carries up to " + capacityOf(radio) + " passengers."
                    : "Up to " + largest + " passengers.";

                if (tooMany) {
                    var options = biggerThan(count);
                    message.textContent = "A " + radio.value + " carries up to " + capacityOf(radio) + " passengers. " +
                        (options.length ? "Choose a " + options.join(" or ") + "." : "Please contact us for a larger group.");
                    message.hidden = false;
                    passengers.setAttribute("aria-invalid", "true");
                    passengers.classList.add("rr-invalid");
                } else {
                    message.textContent = "";
                    message.hidden = true;
                    passengers.removeAttribute("aria-invalid");
                    passengers.classList.remove("rr-invalid");
                }
                return !tooMany;
            }

            passengers.addEventListener("input", check);
            radios.forEach(function (r) { r.addEventListener("change", check); });
            if (passengers.form) {
                passengers.form.addEventListener("submit", function (event) {
                    if (!check()) {
                        event.preventDefault();
                        passengers.focus();
                    }
                });
            }
            check();
        })();
    </script>
}
